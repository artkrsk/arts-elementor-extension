{
  "name": "@arts/elementor-extension",
  "author": "Artem Semkin",
  "version": "1.1.0",
  "type": "module",
  "license": "MIT",
  "description": "Library for creating Elementor extensions, widgets, skins, tabs, and more in declarative way",
  "private": true,
  "engines": {
    "node": ">=23.0.0"
  },
  "dependencies": {
    "@arts/utilities": "file:../ArtsUtilities"
  },
  "devDependencies": {
    "@artemsemkin/elementor-types": "file:../elementor-types",
    "@eslint/js": "^10.0.1",
    "@types/jquery": "^4.0.0",
    "@types/node": "^25.6.0",
    "esbuild": "^0.28.0",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.5.0",
    "prettier": "^3.8.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.61.1"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "format": "prettier --write 'src/ts/**/*.{js,jsx,json,css,ts,tsx}'",
    "format:check": "prettier --check 'src/ts/**/*.{js,jsx,json,css,ts,tsx}'",
    "lint": "eslint 'src/ts/**/*.{js,ts,jsx,tsx}'",
    "lint:fix": "eslint --fix 'src/ts/**/*.{js,ts,jsx,tsx}'",
    "type-check": "tsc --noEmit"
  }
}
